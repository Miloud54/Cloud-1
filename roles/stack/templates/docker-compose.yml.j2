# Managed by Ansible (role: stack). Do not edit on the server.
name: cloud1

services:
  mariadb: 
    image: {{ stack_mariadb_image }}
    restart: unless-stopped
    environment:
      MARIADB_DATABASE: {{ app_db_name }}
      MARIADB_USER: {{ app_db_user }}
      MARIADB_ROOT_PASSWORD_FILE: /run/secrets/db_root_password
      MARIADB_PASSWORD_FILE: /run/secrets/db_password
    secrets:
      - db_root_password
      - db_password
    volumes:
      - db_data:/var/lib/mysql
    networks:
      - backend
    healthcheck:
      test: ["CMD", "healthcheck.sh", "--connect", "--innodb_initialized"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
  
  wordpress:
    build: ./wordpress
    image: cloud1-wordpress:local
    restart: unless-stopped
    depends_on:
      mariadb:
        condition: service_healthy
    environment:
      WORDPRESS_DB_HOST: mariadb
      WORDPRESS_DB_NAME: {{ app_db_name }}
      WORDPRESS_DB_USER: {{ app_db_user }}
      WORDPRESS_DB_PASSWORD_FILE: /run/secrets/db_password
    secrets:
      - db_password
    volumes:
      - wp_data:/var/www/html
    networks:
      - backend
      - frontend
    healthcheck:
      test: ["CMD-SHELL", "test -f /var/www/html/wp-config.php"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s

  phpmyadmin:
    image: {{ stack_phpmyadmin_image }}
    restart: unless-stopped
    depends_on:
      mariadb:
        condition: service_healthy
    environment:
      PMA_HOST: mariadb
      PMA_ABSOLUTE_URI: https://{{ app_domain }}/phpmyadmin/
    volumes:
      - pma_data:/var/www/html
    networks:
      - backend
      - frontend

  nginx:
    image: {{ stack_nginx_image }}
    restart: unless-stopped
    depends_on:
      wordpress:
        condition: service_healthy
      phpmyadmin:
        condition: service_started
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./nginx/conf.d:/etc/nginx/conf.d:ro
      - ./nginx/certs:/etc/nginx/certs:ro
      - wp_data:/var/www/html:ro
      - pma_data:/var/www/phpmyadmin:ro
    networks:
      - frontend

networks:
  backend:
    internal: true
  frontend:

volumes:
  db_data:
  wp_data:
  pma_data:

secrets:
  db_root_password:
    file: ./secrets/db_root_password
  db_password:
    file: ./secrets/db_password
